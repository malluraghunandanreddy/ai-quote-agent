# ---------------------------------------------------------------------------
# AI Quote Creation Agent — POC configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Identities -------------------------------------------------------------
MONITORED_INBOX=quotes@demo.example.com
SALES_TEAM_EMAIL=quotes@demo.example.com
DEMO_CUSTOMER_EMAIL=quotes@demo.example.com
# Comma-separated (Stakeholders A, B, C)
ALERT_RECIPIENTS=quotes@demo.example.com,quotes@demo.example.com,quotes@demo.example.com

# --- Storage ----------------------------------------------------------------
DB_PATH=poc_agent.db

# --- Customer installation lock ------------------------------------------------------
# Restrict this installation to one accounting system / AI provider, so Setup shows only those.
# A locked installation can still switch to demo data (ERP_CONNECTOR=mock) until the real system is connected.
LOCK_ERP_CONNECTOR=
LOCK_AI_PROVIDER=

# --- Accounting / ERP connector ------------------------------------------------
# Which system the draft quotations go into (plug-and-play, see CONNECTORS.md):
#   mock        = offline demo catalogue (data/mock_zoho_catalog.json)
#   zoho_books  = Zoho Books REST API v3 (credentials below)
#   standalone  = no accounting software: price list in Excel, quotes emailed as PDF + Excel
#   webhook     = like standalone, plus each draft POSTed as JSON to WEBHOOK_URL (Zapier / Make / n8n / custom)
ERP_CONNECTOR=mock
WEBHOOK_URL=
# Optional: signs each POST (header X-Quote-Agent-Signature: sha256=<HMAC of body>)
WEBHOOK_SECRET=

# Zoho Books (ERP_CONNECTOR=zoho_books)
# Data centre: com | in | eu | com.au | jp | ca | sa | com.cn
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ESTIMATE_VALIDITY_DAYS=30
# 0..1 — minimum similarity for a fuzzy item-name match (flagged for review)
FUZZY_MATCH_THRESHOLD=0.85
# Lines that match no Zoho item:
#   free_text = still create the draft, add them as free-text lines at rate 0, alert for review
#   exception = do not create the estimate, raise ITEM_NOT_FOUND
UNMATCHED_ITEM_POLICY=free_text

# --- AI layer ------------------------------------------------------------------
# Handles random formats: unknown Excel layouts, items written in the email body,
# and matching vague item descriptions to Zoho items. Empty key = rules only.
# gemini (default) | anthropic | openai
AI_PROVIDER=gemini
# aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option: any OpenAI-compatible API (OpenAI, Azure OpenAI, Groq, DeepSeek, local Ollama …)
# set AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Option: Claude (set AI_PROVIDER=anthropic to use it)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# 0..1 — AI item matches below this confidence are treated as unmatched
AI_MATCH_MIN_CONFIDENCE=0.75

# --- Dashboard "effort saved" estimate (manual quoting time a draft replaces) ---
MANUAL_MINUTES_PER_ENQUIRY=10
MANUAL_MINUTES_PER_LINE=2

# --- Standalone mode (ERP_CONNECTOR=standalone) — for freelancers / no accounting software ---
# price_list.xlsx (item code, name, unit, price, description) and customers.csv live here;
# generated quotations (PDF, Excel, JSON) are written to <dir>/quotes and emailed to SALES_TEAM_EMAIL.
STANDALONE_DIR=data/standalone
# Remember new senders as customers automatically (no customer master needed)
STANDALONE_AUTO_CREATE_CUSTOMERS=true
# Tax added to standalone quotes, e.g. 18 for 18% GST (0 = no tax line)
STANDALONE_TAX_PERCENT=0
QUOTE_NUMBER_PREFIX=QT-
# Printed on the PDF quotation
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_PHONE=
BUSINESS_EMAIL=
QUOTE_TERMS=Prices valid for the period shown. Taxes and freight as stated.

# --- Deployment (Docker) -------------------------------------------------------------
# Public HTTPS: DOMAIN=quotes.yourcompany.com, BIND_ADDRESS=127.0.0.1, then `docker compose --profile https up -d`
DOMAIN=
BIND_ADDRESS=0.0.0.0

# --- Dashboard login -------------------------------------------------------------
# Leave ADMIN_PASSWORD empty only on your own machine; set it before anyone else can reach the dashboard.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Signs login sessions; generated automatically on first start if empty
SESSION_SECRET=

# --- Validation & resilience ------------------------------------------------------
# Extra enquiry fields that must be present, comma-separated (empty = only line items are required).
# Options: customer_name, contact_name, contact_phone, delivery_address, delivery_terms, reference, required_by
REQUIRED_ENQUIRY_FIELDS=
# Temporary failures (network, Zoho outage, rate limit): automatic re-runs of the whole enquiry,
# first after RETRY_DELAY_SECONDS, then doubling. The team is emailed only if all attempts fail.
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=120
# Quick retries inside a single Zoho / SMTP call
ZOHO_HTTP_RETRIES=2
SMTP_RETRY_ATTEMPTS=3
# Used for "open in dashboard" links inside notification emails
DASHBOARD_URL=http://localhost:8000

# --- Outbound mail (internal notification + exception alerts) ---------------
# Leave SMTP_HOST empty to log emails to the dashboard only (no delivery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=quotes@demo.example.com
# true = STARTTLS on 587, false = implicit SSL on 465
SMTP_STARTTLS=true

# --- Monitored inbox (IMAP) -------------------------------------------------
# Leave IMAP_HOST empty to disable polling (use the dashboard upload instead).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=quotes@demo.example.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# 0 = manual polling only (dashboard button)
IMAP_POLL_SECONDS=60


# ===========================================================================
# Node / TypeScript agent (src/, run with `npm start`, `npm run process-now`)
# Shares the IMAP_*, SMTP_*, ZOHO_* and ESTIMATE_VALIDITY_DAYS settings above. ANTHROPIC_API_KEY is shared too.
# (Everything else below is specific to the Node agent.)
# Do not run the Python app and the Node agent against the same mailbox at the same time.
# ===========================================================================

# SQLite file for the Node agent (separate from the Python app's DB_PATH)
AGENT_DB_PATH=data/quote-agent.sqlite

# --- Mailbox -----------------------------------------------------------------
# IMAP over TLS (implicit TLS, port 993). IMAP_USER defaults to the monitored inbox above.
# Optional: move handled mail here instead of only flagging it \Seen
IMAP_PROCESSED_FOLDER=
# Max unread messages handled per polling cycle
IMAP_BATCH_LIMIT=25
# node-cron expression for the poller (default: every 2 minutes)
POLL_CRON=*/2 * * * *
# Run one cycle immediately at startup
RUN_ON_START=true

# --- Notifications -------------------------------------------------------------
# Notification A (more info needed), C (draft created) and "customer not found" go here
# (falls back to SALES_TEAM_EMAIL, then MONITORED_INBOX)
NOTIFY_INTERNAL_EMAIL=quotes@demo.example.com
# Notification B (unmatched / unpriced products). Comma-separated.
EXCEPTION_STAKEHOLDERS=quotes@demo.example.com

# --- Zoho Books (extra settings; ZOHO_DC / CLIENT_ID / SECRET / REFRESH_TOKEN / ORGANIZATION_ID above) ---
# Link style in Notification C: quotes -> #/quotes/{id}, estimates -> #/estimates/{id}
ZOHO_QUOTE_LINK_PATH=quotes
# false = let Zoho price matched lines (item master / customer price list). true = send the item master rate.
ZOHO_SEND_ITEM_RATE=false
# Timezone used for the quote date and expiry date
QUOTE_TIMEZONE=Asia/Kolkata

# --- Claude (the Node agent uses Anthropic only: ANTHROPIC_API_KEY above, model below) ---
# AI_PROVIDER / GEMINI_* / AI_MODEL / AI_EFFORT above are used by the Python app and are ignored here.
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max. "low" is plenty for extraction and keeps cost and latency down.
ANTHROPIC_EFFORT=low
# auto = on when ANTHROPIC_API_KEY is set | true (needs the key) | false (rules only)
LLM_ENABLED=auto
# Retries after the first attempt on 429 / 5xx / overloaded / network errors (done by the SDK)
AI_MAX_RETRIES=2
# Haiku answers in ~2 s; this just bounds a stuck call
AI_TIMEOUT_MS=30000
# Safety net against a flood of mail burning credits: past this many model calls in an hour, the rules-only path runs
LLM_MAX_CALLS_PER_HOUR=600
# USD per 1M tokens, only used for the cost estimate in the logs (Haiku 5.5 list price)
ANTHROPIC_PRICE_IN_PER_MTOK=0.10
ANTHROPIC_PRICE_OUT_PER_MTOK=0.50

# --- Idempotency & limits --------------------------------------------------------
# An identical Excel from the same sender within this window is not processed again
DEDUPE_WINDOW_HOURS=48
# Failed enquiries are retried on later polls up to this many attempts, then the team is alerted
MAX_ATTEMPTS=5
# A PROCESSING row older than this is treated as a crashed run and may be retried
STALE_PROCESSING_MINUTES=15
MAX_ATTACHMENT_MB=15
MAX_EXCEL_ROWS=2000
# Extra free-mail domains (comma-separated) that must never be used for domain matching
PUBLIC_EMAIL_DOMAINS=
LOG_LEVEL=info
