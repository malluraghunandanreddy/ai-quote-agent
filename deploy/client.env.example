# ======================================================================================================================
# Settings for ONE client. Everything here is read when the service starts: change a value, then run ./ctl.sh up.
#
# Rules for this file:
#  - One KEY=value per line, no spaces around "=".
#  - If a value contains $ or # (passwords often do), wrap it in single quotes:  IMAP_PASSWORD='pa$$w#rd'
#  - Keep this file private (it holds keys). new-client.sh already set it to owner-only.
#  - Run ./ctl.sh check after editing: it tells you what is missing before anything starts.
# ======================================================================================================================

# --- How this client is deployed (written by new-client.sh; change only if you know why) -----------------------------
COMPOSE_PROJECT_NAME=__PROJECT__
COMPOSE_FILE=__COMPOSE_FILE__
COMPOSE_PROFILES=__PROFILES__
QUOTE_AGENT_VERSION=__VERSION__
HOST_PORT=__PORT__
DASHBOARD_DOMAIN=__DOMAIN__

# --- The client and the dashboard ----------------------------------------------------------------------------------------
CLIENT_NAME=__CLIENT_NAME__
PUBLIC_DASHBOARD_URL=__PUBLIC_URL__
# true is correct here: the app is only reachable through the proxy / this machine (see docker-compose.yml)
DASHBOARD_TRUST_PROXY=true
QUOTE_TIMEZONE=Asia/Kolkata

# First owner login. The owner signs in with this email and the starting password, then MUST choose their own.
# After that first sign-in, delete the DASHBOARD_PASSWORD line.
DASHBOARD_OWNER_EMAIL=__OWNER_EMAIL__
DASHBOARD_PASSWORD=__OWNER_PASSWORD__

# Branding (all optional). Put the logo file in this client's ./branding folder and name it here.
BRAND_NAME=Quote assistant
BRAND_LOGO=
BRAND_LOGO_ONLY=false
BRAND_COLOR=
BRAND_FOOTER=

# --- Zoho Books (the client's own organisation) --------------------------------------------------------------------------
# in = India. Other data centres: com, eu, com.au, jp, ca, sa, com.cn
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ESTIMATE_VALIDITY_DAYS=30

# --- The mailbox the RFQs arrive in (IMAP) -------------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Alert emails (SMTP) and who gets them ---------------------------------------------------------------------------------
# Without SMTP_HOST, alerts are only written to the log and nobody is emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Internal addresses only: customers are never emailed.
NOTIFY_INTERNAL_EMAIL=
EXCEPTION_STAKEHOLDERS=

# --- Claude (reads messy email text) ---------------------------------------------------------------------------------------
# Without a key the rules-only path runs. Starts with sk-ant-
ANTHROPIC_API_KEY=

# --- Optional tuning (defaults are sensible; see .env.example in the project for every setting) -------------------------
# RETENTION_DAYS=365
# BACKUP_KEEP=14
# DAILY_SUMMARY_CRON=0 8 * * *
# WARN_QUANTITY_ABOVE=100000
# WARN_TOTAL_ABOVE=5000000
